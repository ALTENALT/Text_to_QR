<Window x:Class="Text_to_QR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Text_to_QR"
        mc:Ignorable="d"
        Title="QR Generator" Height="450" Width="800"
        SizeChanged="Window_SizeChanged" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Window.Background>
        <LinearGradientBrush>
            <GradientStop Color="Black" Offset="1"/>
            <GradientStop Color="White" Offset="0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Canvas x:Name="MainCanvas">
        <Button x:Name="GenerateQRButton" Content="Generate QR" Width="100" Height="30" Canvas.Left="10" Canvas.Top="10" Click="GenerateQR_Click" />

        <Border BorderThickness="2" CornerRadius="10" BorderBrush="LightBlue" Background="White" Padding="2" 
                Canvas.Left="124" Canvas.Top="10" Width="300" Height="30">
            <TextBox x:Name="TextInput" Background="Transparent" BorderThickness="0" Text="Text" VerticalContentAlignment="Center" FontFamily="Arial" MaxLines="1" SelectionChanged="QR_Generate" />
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="3" Direction="320" Color="Gray" />
            </Border.Effect>
        </Border>
        <Grid Canvas.Left="10" Canvas.Top="60">
            <Label x:Name="ErrorCorrectionLabel" Content="Error Correction:" HorizontalAlignment="Left" Width="100" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0">
                <RadioButton x:Name="error_Correction_Low" Content="Low" Checked="QR_Generate" Margin="10,0,0,0" />
                <RadioButton x:Name="error_Correction_Medium" Content="Medium" Checked="QR_Generate" Margin="10,0,0,0"/>
                <RadioButton x:Name="error_Correction_Quartile" Content="Quartile" IsChecked="True" Checked="QR_Generate" Margin="10,0,0,0"/>
                <RadioButton x:Name="error_Correction_High" Content="High" Checked="QR_Generate" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>


        <CheckBox x:Name="AutoGenerate" Content="Auto Generate" IsChecked="True" Canvas.Left="10" Canvas.Top="100" />

        <Border Background="#3FFFFFFF" CornerRadius="10" Canvas.Left="10" Canvas.Top="140" Width="200" Height="200" BorderThickness="1">
            <Image x:Name="QrImage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,200,200"/>
                </Image.Clip>
            </Image>
        </Border>


        <Button x:Name="ImageSave" Content="Save Image" Width="100" Height="30" Canvas.Left="10" Canvas.Top="360" Click="ImageSave_Click" />
        <Button x:Name="ImageCopy" Content="Copy Image" Width="100" Height="30" Canvas.Left="120" Canvas.Top="360" Click="ImageCopy_Click" />
    </Canvas>
</Window>